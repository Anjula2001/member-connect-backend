# PostgreSQL
DB_URL=jdbc:postgresql://localhost:5432/member_connect_db
DB_USERNAME=postgres
DB_PASSWORD=your_postgres_password

# AWS S3 (document uploads)
AWS_ACCESS_KEY=your_aws_access_key
AWS_SECRET_KEY=your_aws_secret_key
AWS_REGION=ap-south-1
AWS_BUCKET_NAME=memberconnect-documents

# Auth (JWT). Required - the app will not start without it.
# Base64-encoded key; HS256 needs at least 32 bytes once decoded.
# Generate one with:  openssl rand -base64 48
JWT_SECRET=replace_with_base64_key

# Notifications (email is real SMTP; SMS is a stub that only logs)
NOTIFY_EMAIL_ENABLED=false
NOTIFY_SMS_ENABLED=false
# Gmail rejects a From that is not the authenticated user or a verified alias,
# so keep NOTIFY_EMAIL_FROM and SMTP_USERNAME the same address.
NOTIFY_EMAIL_FROM=no-reply@ffi.lk
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# Server Configuration (Optional)
SERVER_PORT=8080

# Scholarship Rules (Optional defaults shown)
# SCHOLARSHIP_REQUIRED_REMITTED_MONTHS=12
# GRADE5_SCHOLARSHIP_REQUIRED_REMITTED_MONTHS=6
# SCHOLARSHIP_LOOKBACK_YEARS=1
# SCHOLARSHIP_FINANCE_VALIDATION_SOURCE=member
# UNIVERSITY_SCHOLARSHIP_MINOR_REQUIRED_AMOUNT=500
# UNIVERSITY_SCHOLARSHIP_MINOR_REQUIRED_MONTHS=120
# UNIVERSITY_SCHOLARSHIP_MINOR_MULTIPLIER_PERCENT=150
# GRADE5_MINOR_ACCOUNT_REQUIRED_REMITTANCE_AMOUNT=250.0
# MINOR_ACCOUNT_REQUIRED_REMITTANCE_AMOUNT=250.0

# Dispatch (Optional)
# DISPATCH_REQUIRE_ALL_PRINTED=true

# External Integrations (Optional)
# FINANCE_INTEGRATION_ENABLED=false
# FINANCE_BASE_URL=
# FINANCE_DEATH_DONATION_ENABLED=false
# FINANCE_MOCK_ENABLED=false
# LOAN_INTEGRATION_ENABLED=false
# LOAN_BASE_URL=

# Demo Seeding (Optional - enable only for one startup)
# MEMBER_APPLICATION_SEED_DEMO=false
# DORMANT_SEED_DEMO_CANDIDATES=false
# DORMANT_SEED_DEMO_CANDIDATE_COUNT=3
# DORMANT_SEED_BACKFILL_ACTIVITY=false

